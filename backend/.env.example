# ==========================
# Application
# ==========================
APP_NAME="AstraFinance AI"
APP_VERSION="1.0.0"
DEBUG=True

HOST=127.0.0.1
PORT=8000

# ==========================
# MongoDB
# ==========================
MONGODB_URI=mongodb+srv://...
DATABASE_NAME=financial_research_db

# ==========================
# ChromaDB
# ==========================
CHROMA_DB_PATH=./chroma_db

# ==========================
# Firebase Admin SDK
# ==========================
FIREBASE_SERVICE_ACCOUNT_KEY=app/config/astrafinance-ai-firebase-adminsdk-fbsvc-78efa35b8d.json

# ==========================
# LLM API Keys
# ==========================
# Primary single keys (used if numbered keys are absent)
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Multiple keys for round-robin / redundancy
# GROQ_API_KEY_1=your_groq_api_key_1
# GROQ_API_KEY_2=your_groq_api_key_2
# GEMINI_API_KEY_1=your_gemini_api_key_1
# GEMINI_API_KEY_2=your_gemini_api_key_2

# ==========================
# Agent LLM Routing Config
# ==========================
# EXTRACTION_PRIMARY_PROVIDER=groq
# EXTRACTION_PRIMARY_MODEL=llama-3.3-70b-versatile
# EXTRACTION_FALLBACK_PROVIDER=gemini
# EXTRACTION_FALLBACK_MODEL=gemini-3.5-flash

